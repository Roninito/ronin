contract on-discord-mention v1
  description When a Discord message is received, summarize it and save to Apple Notes
  trigger event "discord.message.received"
  parameters {
    folder: Discord
  }
  on_failure {
    action ignore
  }

  initial summarize

  # Phase 1: Summarize the content (web page passed via input)
  phase summarize
    run skill reasoning.summarize
    next save

  # Phase 2: Save the summary to Apple Notes
  phase save
    run skill apple-notes-skill
    complete
